<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>CoinBlitz - Rabbit CEO</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        body {
            background: #090c15;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            position: relative;
        }

        /* --- LOADING / SPLASH SCREEN --- */
        #loadingScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000000;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 20px;
            transition: opacity 0.5s ease;
        }
        .splash-logo {
            font-size: 80px;
            filter: drop-shadow(0 0 20px #ffaa00);
            animation: pulse 1.5s infinite alternate;
        }
        @keyframes pulse {
            0% { transform: scale(0.95); }
            100% { transform: scale(1.05); }
        }
        .spinner {
            width: 45px;
            height: 45px;
            border: 4px solid rgba(255, 170, 0, 0.2);
            border-top: 4px solid #ffaa00;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .loading-title {
            font-size: 24px;
            font-weight: 900;
            color: #ffaa00;
            letter-spacing: 1px;
        }

        /* --- MAIN GAME CONTAINER --- */
        .game-container {
            padding: 12px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex: 1;
        }

        /* Top Info & Stats */
        .top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }
        .profile-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .wallet-btn {
            background: linear-gradient(135deg, #0088cc, #005588);
            border: none;
            color: #fff;
            padding: 8px 14px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 11px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 136, 204, 0.4);
        }

        /* 3 Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin-top: 10px;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 8px 4px;
            text-align: center;
        }
        .stat-label {
            font-size: 9px;
            color: #8b949e;
            text-transform: uppercase;
        }
        .stat-val {
            font-size: 12px;
            font-weight: 800;
            color: #ffaa00;
            margin-top: 2px;
        }

        /* Score Display */
        .score-box {
            text-align: center;
            margin: 12px 0;
        }
        .score-val {
            font-size: 38px;
            font-weight: 900;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* --- CHARACTER SPOTLIGHT STAGE --- */
        .stage-area {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            flex: 1;
            margin: 10px 0;
        }
        .pedestal {
            width: 200px;
            height: 45px;
            background: radial-gradient(ellipse at center, rgba(0, 229, 255, 0.6) 0%, rgba(0, 85, 255, 0.2) 60%, rgba(0,0,0,0) 100%);
            border-radius: 50%;
            position: absolute;
            bottom: 5px;
            box-shadow: 0 0 30px rgba(0, 229, 255, 0.5);
        }
        .rabbit-avatar {
            font-size: 130px;
            z-index: 2;
            cursor: pointer;
            transition: transform 0.05s;
            filter: drop-shadow(0 10px 20px rgba(0,0,0,0.8));
        }
        .rabbit-avatar:active {
            transform: scale(0.92);
        }

        /* Floating Numbers */
        .floating-num {
            position: absolute;
            font-size: 32px;
            font-weight: 900;
            color: #ffaa00;
            text-shadow: 0 0 10px #ff5500;
            pointer-events: none;
            z-index: 10;
            animation: floatUp 0.8s ease-out forwards;
        }
        @keyframes floatUp {
            0% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-80px); }
        }

        /* Energy & Audio Controls */
        .control-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 10px;
            margin-bottom: 10px;
        }
        .energy-txt {
            font-size: 14px;
            font-weight: 800;
            color: #ffffff;
        }
        .music-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 6px 10px;
            color: #fff;
            font-size: 11px;
            cursor: pointer;
        }

        /* Bottom Tab Bar */
        .nav-bar {
            background: #121620;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            padding: 6px;
        }
        .nav-tab {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            color: #8b949e;
            font-size: 10px;
            font-weight: 700;
            padding: 6px 0;
            cursor: pointer;
            border-radius: 10px;
        }
        .nav-tab.active {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }
        .nav-icon {
            font-size: 18px;
        }
    </style>
</head>
